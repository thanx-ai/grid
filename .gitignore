# This is a public repo — anything ignored here is also a hint to grep
# diffs for before pushing. See CLAUDE.md "This is a public repo".

# Local env / credentials — NEVER commit
.env
.env.*
.wmill/
.netrc
.npmrc
.pypirc

# Credential file formats — defense in depth against accidental `git add .`
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
credentials*
secrets*
!secrets-template.*
# Common SSH private key filenames + bare htpasswd. The bare names cover
# the private keys (the dangerous side); `id_*.pub` is left allowed since
# public keys are safe to commit.
id_rsa
id_ed25519
id_ecdsa
id_dsa
.htpasswd

# Node / runtime
node_modules/
*.log
.DS_Store

# IDE
.idea/
.vscode/

# Claude Code phase-chain artifacts (session-local)
.context/

# Managed-rule temp files written by `/grid:setup` Step 4's mktemp pattern.
# Belt-and-braces: the script `mv`s them in place, but if it's interrupted
# mid-flight (Ctrl-C, panic) the temp file is left behind.
claude/rules/.tmp.*

# Claude Code local-only state — team-shared content under .claude/
# (settings.json, agents/, commands/) stays committed
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/projects/
.claude/shell-snapshots/
.claude/todos/
.claude/statsig/

# Local actionlint binary (downloaded by the self-test workflow and dev loop)
/actionlint
